# Copy this file to .env and fill in your key. Never commit the real .env file.

# API key from https://openrouter.ai/ -- a free account is enough for the default model below.
OPENROUTER_API_KEY=

# Usually no need to change these:
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Free-tier model (no credits required). Free ":free" models are capped at 20 requests/minute
# and 50 requests/day on an account that has never purchased credits -- batch with --num-items
# rather than making many small calls. See DESIGN.md §7 for why this model specifically.
AFRILEARNER_LLM_MODEL=google/gemma-4-26b-a4b-it:free
