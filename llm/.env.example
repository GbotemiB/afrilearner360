# Copy this file to .env and fill in your key. Never commit the real .env file.

# API key from https://openrouter.ai/ (used for MiniMax M3 and any other model swapped in later)
OPENROUTER_API_KEY=

# Usually no need to change these:
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AFRILEARNER_LLM_MODEL=minimax/minimax-m3
